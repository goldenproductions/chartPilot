# Normalise line endings so a checkout on Windows and one on Linux agree.
* text=auto eol=lf

# Windows-only tooling expects CRLF.
*.sln       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Never touch these.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff2     binary

# Keep generated and vendored files out of language statistics and diffs.
src/chartpilot-web/package-lock.json  linguist-generated=true -diff
docs/tutorial.html                    linguist-generated=true
tests/**/Fixtures/**                  linguist-vendored=true
